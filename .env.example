# Copia este archivo a .env y completa con tus propios valores.
# NUNCA commitear .env con valores reales.

# Recommended for most uses
DATABASE_URL=

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=

# Parameters for constructing your own connection string
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Parameters used by Prisma (prisma/schema.prisma)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# Secreto para autorizar el endpoint /api/cron/process-recurring
CRON_SECRET=

# Secreto de firma de sesiones JWT (mínimo 32 caracteres, generar con: openssl rand -base64 48)
JWT_SECRET=

# Opcional: rate limiting distribuido con Upstash Redis (lib/rate-limit.ts).
# Sin esto, el rate limit funciona en memoria por instancia (no compartido entre
# instancias serverless). Crea una base gratis en https://console.upstash.com
# y copia estas dos variables desde su REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
