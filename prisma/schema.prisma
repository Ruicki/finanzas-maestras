generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model AdditionalIncome {
  id             Int       @id @default(autoincrement())
  name           String
  amount         Decimal   @db.Decimal(10, 2)
  type           String
  frequency      String?
  durationMonths Int?
  profileId      Int
  accountId      Int?
  createdAt      DateTime  @default(now())
  date           DateTime?
  icon           String    @default("Wallet")
  account        Account?  @relation(fields: [accountId], references: [id])
  profile        Profile   @relation(fields: [profileId], references: [id])
}

model Salary {
  id         Int      @id @default(autoincrement())
  grossVal   Decimal  @db.Decimal(10, 2)
  netVal     Decimal  @db.Decimal(10, 2)
  taxes      Decimal  @db.Decimal(10, 2)
  socialSec  Decimal  @db.Decimal(10, 2)
  eduIns     Decimal  @db.Decimal(10, 2)
  incomeTax  Decimal  @db.Decimal(10, 2)
  bonus      Decimal  @db.Decimal(10, 2)
  absentDays Int      @default(0)
  createdAt  DateTime @default(now())
  company    String?
  profileId  Int?
  accountId  Int?
  account    Account? @relation(fields: [accountId], references: [id])
  profile    Profile? @relation(fields: [profileId], references: [id])
}

model Profile {
  id               Int                @id @default(autoincrement())
  name             String
  createdAt        DateTime           @default(now())
  role             String             @default("USER")
  customDeductions String?
  email            String?            @unique
  password         String?
  accessCode       String?            @unique
  accounts         Account[]
  incomes          AdditionalIncome[]
  categories       Category[]
  creditCards      CreditCard[]
  expenses         Expense[]
  goals            Goal[]
  loans            Loan[]
  salaries         Salary[]
}

model Expense {
  id              Int       @id @default(autoincrement())
  name            String
  amount          Decimal   @db.Decimal(10, 2)
  category        String
  categoryId      Int?
  dueDate         Int?
  isRecurring     Boolean   @default(true)
  isOneTime       Boolean   @default(false)
  recurrenceType  String?   @default("MONTHLY")
  paymentMethod   String?
  linkedCardId    Int?
  profileId       Int
  accountId       Int?
  createdAt       DateTime  @default(now())
  account         Account?  @relation(fields: [accountId], references: [id])
  categoryRel     Category? @relation(fields: [categoryId], references: [id])
  profile         Profile   @relation(fields: [profileId], references: [id])
}

model Category {
  id              Int       @id @default(autoincrement())
  name            String
  icon            String
  color           String
  type            String
  monthlyLimit    Decimal?  @db.Decimal(10, 2)
  profileId       Int
  createdAt       DateTime  @default(now())
  isRollover      Boolean   @default(false)
  rolloverBalance Decimal   @default(0) @db.Decimal(10, 2)
  profile         Profile   @relation(fields: [profileId], references: [id])
  expenses        Expense[]
}

model Goal {
  id                 Int       @id @default(autoincrement())
  name               String
  targetAmount       Decimal   @db.Decimal(10, 2)
  currentAmount      Decimal   @default(0) @db.Decimal(10, 2)
  deadline           DateTime?
  type               String    @default("VARIABLE")
  frequency          String?
  contributionAmount Decimal?  @db.Decimal(10, 2)
  priority           String?   @default("MEDIUM")
  category           String?
  notes              String?
  isPaused           Boolean   @default(false)
  sourceAccountId    Int?
  destinationAccountId Int?
  profileId          Int
  createdAt          DateTime  @default(now())
  profile            Profile   @relation(fields: [profileId], references: [id])
  transactions       GoalTransaction[]
}

model GoalTransaction {
  id          Int      @id @default(autoincrement())
  goalId      Int
  type        String   // DEPOSIT, WITHDRAW
  amount      Decimal  @db.Decimal(10, 2)
  note        String?
  accountId   Int?
  createdAt   DateTime @default(now())
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model CreditCard {
  id                   Int      @id @default(autoincrement())
  name                 String
  limit                Decimal  @db.Decimal(10, 2)
  balance              Decimal  @default(0) @db.Decimal(10, 2)
  cutoffDay            Int
  paymentDay           Int
  interestRate         Decimal? @db.Decimal(6, 2)
  annualFee            Decimal? @db.Decimal(10, 2)
  minPaymentPercentage Decimal? @default(3.0) @db.Decimal(6, 2)
  insuranceRate        Decimal? @default(0.25) @db.Decimal(6, 2)
  itbmsRate            Decimal? @default(0.07) @db.Decimal(4, 2)
  minPaymentFloor      Decimal? @default(0) @db.Decimal(10, 2)
  profileId            Int
  createdAt            DateTime @default(now())
  annualFeeMonth       Int?
  bank                 String?
  lateFee              Decimal? @default(25.0) @db.Decimal(10, 2)
  profile              Profile  @relation(fields: [profileId], references: [id])
}

model Loan {
  id             Int      @id @default(autoincrement())
  name           String
  lender         String
  type           String
  totalAmount    Decimal  @db.Decimal(12, 2)
  currentBalance Decimal  @db.Decimal(12, 2)
  interestRate   Decimal? @db.Decimal(6, 2)
  termMonths     Int?
  monthlyPayment Decimal? @db.Decimal(10, 2)
  paymentDay     Int?
  isAutomatic    Boolean  @default(false)
  profileId      Int
  createdAt      DateTime @default(now())
  startDate      DateTime @default(now())
  profile        Profile  @relation(fields: [profileId], references: [id])
}

model Account {
  id            Int                @id @default(autoincrement())
  name          String
  type          String
  purpose       String             @default("SPENDING")
  balance       Decimal            @default(0) @db.Decimal(12, 2)
  currency      String             @default("USD")
  profileId     Int
  createdAt     DateTime           @default(now())
  isDefault     Boolean            @default(false)
  lockDate      DateTime?
  profile       Profile            @relation(fields: [profileId], references: [id])
  incomes       AdditionalIncome[]
  expenses      Expense[]
  salaries      Salary[]
  transfersTo   Transfer[]         @relation("DestinationAccount")
  transfersFrom Transfer[]         @relation("SourceAccount")
}

model Transfer {
  id                   Int      @id @default(autoincrement())
  amount               Decimal  @db.Decimal(10, 2)
  description          String?
  date                 DateTime @default(now())
  sourceAccountId      Int
  destinationAccountId Int
  destinationAccount   Account  @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  sourceAccount        Account  @relation("SourceAccount", fields: [sourceAccountId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?
  actorId   Int?
  targetId  Int?
  profileId Int?
  oldBalance Decimal? @db.Decimal(12, 2)
  newBalance Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
}
